# ==============================================================================
# StayCraft Hotel Management Frontend - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and adjust for your local or production environment.

# ------------------------------------------------------------------------------
# 1. API & Backend Connectivity
# ------------------------------------------------------------------------------
# In Development: Point to local Django REST API
API_URL=http://localhost:8000/api/v1

# In Production:
# API_URL=https://api.staycrafthotel.com/api/v1

# ------------------------------------------------------------------------------
# 2. Site Metadata & Identity
# ------------------------------------------------------------------------------
SITE_URL=http://localhost:3007
APP_NAME=StayCraft Hotel
APP_DESCRIPTION="StayCraft Luxury Hotel & Room Management System"

